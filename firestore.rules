rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserDocOwner(resourceData) {
      return isSignedIn() && (
        resourceData.userId == request.auth.uid || 
        resourceData.user == request.auth.token.email
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'wangechigodfrey77@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff')
      );
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Exams & Questions repository (Public read & write for exam management and practice)
    match /exams/{examId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }

    // User-specific exam history logging
    match /examHistory/{historyId} {
      allow read: if isSignedIn() && (isUserDocOwner(resource.data) || isStaff());
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.user == request.auth.token.email
      );
      allow update, delete: if isSignedIn() && (isUserDocOwner(resource.data) || isAdmin());
    }

    // User-specific favorites & bookmarks
    match /Favorites/{favoriteId} {
      allow read: if isSignedIn() && (isUserDocOwner(resource.data) || isStaff());
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.user == request.auth.token.email
      );
      allow update, delete: if isSignedIn() && (isUserDocOwner(resource.data) || isAdmin());
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (isUserDocOwner(resource.data) || isStaff());
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.user == request.auth.token.email
      );
      allow update, delete: if isSignedIn() && (isUserDocOwner(resource.data) || isAdmin());
    }

    // Payment transactions
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isUserDocOwner(resource.data) || isStaff());
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.user == request.auth.token.email
      );
      allow update, delete: if isAdmin();
    }

    // System & User Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isSignedIn() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) || isStaff());
      allow delete: if isSignedIn() && (isStaff() || isAdmin());
    }

    // Badge Gamification Configurations
    match /badgeConfigs/{badgeId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }
    
    // Default fallback deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

