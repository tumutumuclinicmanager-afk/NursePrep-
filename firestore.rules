rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profiles - allow read and write for auth lookup and user creation
    match /users/{userId} {
      allow read, write: if true;
    }

    // Exams & Questions repository (Public read for practice, authenticated write for staff/lecturers)
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User-specific exam history logging
    match /examHistory/{historyId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.user == request.auth.token.email || resource.data.userId == request.auth.uid);
    }

    // User-specific favorites & bookmarks
    match /Favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.user == request.auth.token.email || resource.data.userId == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.user == request.auth.token.email || resource.data.userId == request.auth.uid);
    }

    // Payment transactions
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.user == request.auth.token.email || resource.data.userId == request.auth.uid);
    }
    
    // Default rule for other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
